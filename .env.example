# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this to .env and fill in your real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# -- LLM Providers -----------------------------------------------------------
# Hugging Face token (enable "Make calls to Inference Providers" at
# https://huggingface.co/settings/tokens)
Hf_token=hf_YOUR_TOKEN_HERE

# Groq API key (fallback provider)
# https://console.groq.com/keys
groq_api_key=gsk_YOUR_KEY_HERE

# -- Database (Supabase Postgres) --------------------------------------------
# From your Supabase project -> Settings -> Database -> Connection string (URI)
SUPABASE_DB_URI=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# -- Frontend (optional, defaults to localhost:8000) -------------------------
# Point this at your deployed FastAPI URL in production.
API_BASE=http://localhost:8000

# -- CORS (optional, defaults to localhost:8501) -----------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
